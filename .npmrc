# ──────────────────────────────────────────────
# .npmrc — npm behavior configuration
# ──────────────────────────────────────────────

# Allow native modules (better-sqlite3) to run their install scripts so the
# prebuilt binary is fetched for your Node version (incl. Node v24).
# Without this, npm v9+ may block the script and `require('better-sqlite3')`
# will throw an error on first run.
# If your npm version doesn't understand `allow-scripts`, this line is harmless.
allow-scripts=true

# Prefer the prebuilt binary over compiling from source (faster, no toolchain).
# Falls back to a source build automatically if no prebuilt matches.
fund=false
audit-level=high
